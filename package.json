{
  "name": "hello-wasm02",
  "version": "0.1.0",
  "description": "Rust + web_sys + Vite starter",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "CARGO_TARGET_DIR=${CARGO_TARGET_DIR_BASE:-$HOME/.cache/cargo-targets}/hello-wasm02-wasm wasm-pack build --target web --out-dir web/pkg",
    "wasm:dev": "CARGO_TARGET_DIR=${CARGO_TARGET_DIR_BASE:-$HOME/.cache/cargo-targets}/hello-wasm02-wasm wasm-pack build --dev --target web --out-dir web/pkg",
    "wasm:ensure": "test -f web/pkg/hello_wasm02.js || npm run wasm:dev",
    "clean:wasm": "rm -rf target-wasm-test web/pkg",
    "clean:host": "rm -rf ${CARGO_TARGET_DIR_BASE:-$HOME/.cache/cargo-targets}/hello-wasm02-host",
    "clean:all": "npm run clean:wasm && npm run clean:host && cargo clean",
    "start": "npm run wasm:dev && vite",
    "server": "cargo run --manifest-path auth-server/Cargo.toml",
    "server:release": "cargo run --release --manifest-path auth-server/Cargo.toml",
    "test:host": "CARGO_TARGET_DIR=${CARGO_TARGET_DIR_BASE:-$HOME/.cache/cargo-targets}/hello-wasm02-host cargo test",
    "test:node": "./scripts/wasm-test.sh node",
    "test:chrome": "./scripts/wasm-test.sh chrome",
    "test:firefox": "./scripts/wasm-test.sh firefox",
    "test:all": "npm run test:host && npm run test:node && npm run test:chrome && npm run test:firefox",
    "test": "npm run test:host && npm run test:node && npm run test:chrome",
    "dev": "vite",
    "build": "npm run wasm && vite build",
    "preview": "vite preview",
    "dev:fresh": "npm run clean:wasm && npm run wasm:dev && vite",
    "dev:full": "concurrently -n server,vite -c blue,green \"npm:server\" \"npm:dev\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "vite": "^8.2.2"
  }
}